# Krishi-Net API settings (example values only; never commit live credentials).
ENVIRONMENT=development
DATABASE_URL=sqlite:///./krishi_net.db
# Production: use persistent PostgreSQL, strong SECRET_KEY, specific CORS origins.
# DATABASE_URL=postgresql://user:password@host:5432/krishi_net
SECRET_KEY=replace_with_a_secure_random_value_at_least_32_characters
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Optional hosted AI provider (server side only).
GROQ_API_KEY=
# SMTP/SMS providers require real credentials only in the deployment secret manager.
SMTP_EMAIL=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
